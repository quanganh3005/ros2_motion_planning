  <version>0.0.1</version>
  <description>Simulation environment for ROS 2 Humble and Gazebo Fortress (Ignition 6)</description>
  <maintainer email="913982779@qq.com">Winter</maintainer>
  <maintainer email="guo.zhanyu@qq.com">ZhanyuGuo</maintainer>
  <license>BSD</license>
  <author email="913982779@qq.com">Winter</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>
