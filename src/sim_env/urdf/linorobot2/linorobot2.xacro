<?xml version="1.0" encoding="utf-8"?>
<robot name="linorobot2" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==================== Base Footprint ==================== -->
  <link name="base_footprint"/>

  <!-- ==================== Base Link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.02" rpy="0 0 0" />
      <mass value="2.5" />
      <inertia
        ixx="0.0115" ixy="0.0" ixz="0.0"
        iyy="0.0148" iyz="0.0"
        izz="0.0227" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/base_link.STL" />
      </geometry>
      <material name="yellow">
        <color rgba="0.95 0.76 0.18 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="base_to_footprint" type="fixed">
    <origin xyz="0 0 0.06475" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <!-- ==================== Front Caster Wheel ==================== -->
  <link name="front_caster_wheel_link">
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia
        ixx="0.0000045" ixy="0.0" ixz="0.0"
        iyy="0.0000045" iyz="0.0"
        izz="0.0000045" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/front_caster_wheel_link.STL" />
      </geometry>
      <material name="grey">
        <color rgba="0.9 0.9 0.9 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.015" />
      </geometry>
    </collision>
  </link>

  <joint name="front_caster_wheel_joint" type="fixed">
    <origin xyz="0.11 0 -0.06475" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_caster_wheel_link" />
  </joint>

  <!-- ==================== IMU Link ==================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia
        ixx="0.000001" ixy="0.0" ixz="0.0"
        iyy="0.000001" iyz="0.0"
        izz="0.000001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/imu_link.STL" />
      </geometry>
      <material name="light_grey">
        <color rgba="0.92 0.92 0.92 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/imu_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_to_base_link" type="fixed">
    <origin xyz="0.0877 0 0.0166" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

  <!-- ==================== Laser Link ==================== -->
  <link name="laser">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <mass value="0.17" />
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/laser.STL" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.21 0.21 0.20 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/laser.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_to_base_link" type="fixed">
    <origin xyz="-0.0075 0.0 0.12" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser" />
  </joint>

  <!-- ==================== Right Wheel ==================== -->
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 -0.015 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia
        ixx="0.000057" ixy="0.0" ixz="0.0"
        iyy="0.000096" iyz="0.0"
        izz="0.000057" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/right_wheel_link.STL" />
      </geometry>
      <material name="orange">
        <color rgba="0.83 0.67 0.13 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.015 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.077 -0.1004 -0.02475" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- ==================== Left Wheel ==================== -->
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0.015 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia
        ixx="0.000057" ixy="0.0" ixz="0.0"
        iyy="0.000096" iyz="0.0"
        izz="0.000057" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sim_env/meshes/linorobot2/left_wheel_link.STL" />
      </geometry>
      <material name="orange">
        <color rgba="0.83 0.67 0.13 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.015 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.077 0.1004 -0.02475" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- ==================== Gazebo Fortress Plugins ==================== -->

  <!-- Diff Drive System Plugin -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.2008</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher System Plugin -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>/imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- RPLidar A1 LiDAR Sensor -->
  <gazebo reference="laser">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <topic>/scan</topic>
      <ignition_frame_id>laser</ignition_frame_id>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.18</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- Materials and Friction -->
  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="front_caster_wheel_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <material>Gazebo/Orange</material>
  </gazebo>

</robot>
